[node name="LevelIntro" type="Node2D"]
script = ExtResource("1_2bpys")
characters_per_second = 15.0
intro_text = "Welcome to the \"Not even an alpha\" release of [p][b]Rexx Tangle: Gnome Rescue[/b][/p]
This is just the first level of the game and does not include the story elements, or even a tutorial.

Controls:
Left: ←
Right: →
Jump: [Spacebar]
Double Jump: Hit space when already jumping
Wall Jump: Jump into a wall and then hit jump again while touching the wall. Wall jumps can be chained together. "
